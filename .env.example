# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/camxlk?retryWrites=true&w=majority

# JWT Authentication Secret Key
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production

# CORS Allowed Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://camx.lk,https://admin.camx.lk

# Email Configuration (Nodemailer / OTP)
EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# PayHere Payment Gateway Credentials
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_SANDBOX=true

